# Porta do serviço fiscal
FISCAL_SERVICE_PORT=3334

# Chave interna exigida no header X-INTEGRA-INTERNAL-KEY (mesma da API Node)
FISCAL_INTERNAL_KEY=

# Diretório de armazenamento de certificados, XMLs, DANFEs e logs
FISCAL_STORAGE_PATH=./storage

# homologation | production
FISCAL_DEFAULT_ENVIRONMENT=homologation

# Chave AES-256-GCM em hex (64 chars) — mesma APP_ENCRYPTION_KEY da API Node,
# usada para decifrar senha do certificado A1 e CSC token.
FISCAL_ENCRYPTION_KEY=
