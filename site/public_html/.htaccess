# Integra Code — Apache/LiteSpeed rules (Hostinger)
Options -Indexes -MultiViews
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and non-www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Block internal folders and sensitive files
  RewriteRule ^(inc|storage)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(sqlite|log|md|lock|sh)$ - [F,L]

  # API front controller
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # Blog posts: /blog/slug
  RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [QSA,L]

  # Remove trailing slash on pages (not directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Redirect direct .php access to clean URL (except entry points)
  RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.php[\s?] [NC]
  RewriteCond %1 !^(index|install|post|404)$ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Clean URLs: /sobre -> sobre.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-z0-9-]+)$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # CSS/JS: revalidate on every load (304 when unchanged) so a deploy reaches every browser at once
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

<FilesMatch "^(config\.php|cli\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
